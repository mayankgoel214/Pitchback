generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // Pooled connection (PgBouncer, port 6543 on Supabase). Every request-time
  // query goes through here, because serverless opens far more connections
  // than Postgres will hold.
  url = env("DATABASE_URL")

  // Direct connection (port 5432). Migrations need it: PgBouncer's
  // transaction pooling cannot run the advisory locks and prepared
  // statements a migration uses, and the failure looks like a network fault
  // rather than a configuration one. Optional — falls back to `url` when
  // unset, which is what the local Docker setup does.
  directUrl = env("DIRECT_URL")
}

/// A completed practice run. Anonymous by construction — there are no
/// accounts, and nothing here identifies the person who did it. Stored so
/// the landing page can report real aggregates instead of invented ones.
model Run {
  id         String   @id @default(cuid())
  scenarioId String   @map("scenario_id")
  createdAt  DateTime @default(now()) @map("created_at")

  /// The conversation so far. Held server-side rather than relayed by the
  /// client, so a run's scores cannot be forged by editing a request body.
  /// Shape: { role: "rep" | "buyer", text: string }[]
  transcript Json @default("[]")

  /// Every state machine transition, in order, with its trigger.
  stateHistory Json   @default("[]") @map("state_history")
  /// Current rung of the buyer receptivity ladder.
  state        String

  /// Round-trip latency samples for this run, in milliseconds: recording
  /// stopped to buyer audio ready. Shape: number[]
  latencies Json @default("[]")

  // --- set once the run is graded ---
  completedAt DateTime? @map("completed_at")
  /// How the call ended: "committed", "hung_up", or "out_of_turns".
  outcome     String?
  turns       Int       @default(0)

  discovery         Int?
  talkListen        Int? @map("talk_listen")
  objectionHandling Int? @map("objection_handling")
  nextStep          Int? @map("next_step")
  overall           Int?

  /// The four scored competencies with the reasoning shown to the user, so
  /// a result page can be re-rendered without paying the grader again.
  competencies Json?

  @@index([createdAt])
  @@index([scenarioId])
  @@index([completedAt])
  @@map("runs")
}

/// Fixed-window rate limiting. Kept in Postgres rather than in process
/// memory because every serverless instance has its own memory, and a
/// per-instance limit on a paid endpoint is not a limit at all.
model RateLimitWindow {
  /// Hashed client identifier plus the endpoint being limited.
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("rate_limit_windows")
}

/// Cached text-to-speech audio. The buyer's opening line for a scenario is
/// identical on every run, so it should be synthesised once, not once per
/// visitor.
model SpeechCache {
  /// Hash of voice + model + text.
  key       String   @id
  audio     Bytes
  createdAt DateTime @default(now()) @map("created_at")

  @@map("speech_cache")
}
